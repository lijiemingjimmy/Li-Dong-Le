ARG REDROID_IMAGE=erstt/redroid@sha256:7c1f4355fa245e55cc15fa46ff3be8c347cee73c3eeb5c8b7a6def93013eb54d
ARG PYTHON_IMAGE=python:3.13-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
FROM ${REDROID_IMAGE} AS upstream
FROM ${PYTHON_IMAGE} AS guard
ARG TARGETARCH
ARG FRIDA_ASSET_BASE=https://github.com/frida/frida/releases/download/16.7.19
ARG FRIDA_LICENSE_BASE
COPY --from=upstream /system/etc/init/ /work/system-init/
COPY --from=upstream /vendor/etc/init/ /work/vendor-init/
COPY deploy/guard_init.py /guard_init.py
RUN python3 /guard_init.py /work/system-init /work/vendor-init
COPY deploy/fetch_frida.py /fetch_frida.py
RUN python3 /fetch_frida.py "$TARGETARCH"
FROM upstream
COPY --from=guard /work/system-init/ /system/etc/init/
COPY --from=guard /work/vendor-init/ /vendor/etc/init/
COPY LICENSE THIRD_PARTY.md /licenses/
COPY --from=guard /work/frida-server /system/bin/ldl-frida-server
COPY --from=guard /work/frida-licenses/ /licenses/frida/
COPY --chmod=0644 deploy/ldl-netcompat.rc /system/etc/init/ldl-netcompat.rc
